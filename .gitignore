# Python
venv/
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Env / secrets
.env
.env.local
kaggle.json

# Data (raw/interim/processed are pulled or generated, not committed)
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Trained model artifacts (large binaries, not committed)
models/*.pkl
models/*.pt
models/*.joblib
!models/.gitkeep

# app/ is Devyani's separate, live GitHub repo (Market-Minds), cloned in-place -- it has
# its own .git and is pushed to independently. Fully ignored here so this outer repo never
# tries to track its contents.
app/

# Ad-hoc debugging screenshots (image.png, image2.png, ... pasted into chat while debugging)
notebooks/image*.png

# OS
.DS_Store
